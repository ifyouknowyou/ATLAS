# Database (see docker-compose.yml — atlas-postgres on :5434, test on :5435)
DATABASE_URL=postgresql://atlas:atlas_dev_password@127.0.0.1:5434/atlas
DATABASE_URL_TEST=postgresql://atlas:atlas_dev_password@127.0.0.1:5435/atlas_test

# API
# Comma-separated list of Origin headers the API allows (CSRF / CORS hardening).
CORS_ORIGINS=http://localhost:3000
# Secret used to sign session JWTs. MUST be replaced in production (env-specific).
AUTH_JWT_SECRET=atlas_dev_only_change_me
# JWT lifetime
AUTH_JWT_EXPIRES_IN=12h
# Bcrypt cost for password hashing
AUTH_BCRYPT_ROUNDS=12

# Seed credentials for the demo tenant (dev only)
DEMO_OWNER_EMAIL=admin@atlas.demo
DEMO_OWNER_PASSWORD=AtlasDemo#2026

# Port the NestJS API listens on
API_PORT=4100
NODE_ENV=development

# AI Intelligence Engine (Phase 4). ANTHROPIC_API_KEY is optional — when absent
# the /api/ai endpoints report 503 "not configured". It is read server-side only
# and never exposed to the web client. Model default: claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Phase 5 — Evidence Vault storage. ATLAS_STORAGE_DIR is a server-side directory
# for uploaded evidence files (git-ignored). Never exposed to clients directly;
# downloads flow through authorized /evidence/:id/download (or short-lived
# signed URLs).
ATLAS_STORAGE_DIR=./.storage
# Max accepted upload size in MiB
ATLAS_MAX_UPLOAD_MB=25
# Lifetime (seconds) of short-lived signed download URLs
ATLAS_SIGNED_URL_TTL_S=120
# Background job poll interval (ms) for the in-process queue
ATLAS_JOBS_POLL_INTERVAL_MS=2000