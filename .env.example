# Database (see docker-compose.yml — atlas-postgres on :5434, test on :5435)
DATABASE_URL=postgresql://atlas:atlas_dev_password@127.0.0.1:5434/atlas
DATABASE_URL_TEST=postgresql://atlas:atlas_dev_password@127.0.0.1:5435/atlas_test

# API
# Comma-separated list of Origin headers the API allows (CSRF / CORS hardening).
CORS_ORIGINS=http://localhost:3000
# Secret used to sign session JWTs. MUST be replaced in production (env-specific).
AUTH_JWT_SECRET=atlas_dev_only_change_me
# JWT lifetime
AUTH_JWT_EXPIRES_IN=12h
# Bcrypt cost for password hashing
AUTH_BCRYPT_ROUNDS=12

# Seed credentials for the demo tenant (dev only)
DEMO_OWNER_EMAIL=admin@atlas.demo
DEMO_OWNER_PASSWORD=AtlasDemo#2026

# Port the NestJS API listens on
API_PORT=4100
NODE_ENV=development